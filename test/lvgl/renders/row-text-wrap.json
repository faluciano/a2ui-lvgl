{
  "name": "Row text wrap",
  "description": "Adapter render fixture: long Text in a Row wraps in the space its siblings leave.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "row-text-wrap",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "row-text-wrap",
        "components": [
          {"id": "root", "component": "Column", "children": ["c1", "c2", "c3", "c4"]},
          {"id": "c1", "component": "Card", "child": "r1"},
          {"id": "r1", "component": "Row", "align": "center", "children": ["i1", "t1"]},
          {"id": "i1", "component": "Icon", "name": "mail"},
          {"id": "t1", "component": "Text", "text": "Your order has shipped and will arrive on Thursday between 9 am and noon. Track it from the orders page."},
          {"id": "c2", "component": "Card", "child": "r2"},
          {"id": "r2", "component": "Row", "children": ["t2", "t3"]},
          {"id": "t2", "component": "Text", "text": "A longer description on the left that needs several lines to fit"},
          {"id": "t3", "component": "Text", "text": "Shorter note on the right"},
          {"id": "c3", "component": "Card", "child": "r3"},
          {"id": "r3", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["t4", "b1"]},
          {"id": "t4", "component": "Text", "text": "Allow notifications from this device so reminders reach you on time"},
          {"id": "b1", "component": "Button", "variant": "primary", "child": "bt", "action": {"event": {"name": "allow"}}},
          {"id": "bt", "component": "Text", "text": "Allow"},
          {"id": "c4", "component": "Card", "child": "r4"},
          {"id": "r4", "component": "Row", "justify": "spaceBetween", "children": ["t5", "t6"]},
          {"id": "t5", "component": "Text", "text": "Subtotal"},
          {"id": "t6", "component": "Text", "text": "$42.00"}
        ]
      }
    }
  ]
}
